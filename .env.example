# ContentHub CMS Environment Variables Template
# Copy this file to server/.env and fill in the values for your environment.
# NEVER commit your production .env file to version control.

# Backend Server Port
PORT=5090

# PostgreSQL Database Connection String
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contenthub_db

# Cryptographically Secure JWT Secret Key (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_cryptographically_secure_jwt_secret_min_32_chars_here

# Frontend Client URL for CORS Whitelisting
CLIENT_URL=http://localhost:5173

# Optional: Enable SSL for Remote PostgreSQL connections (true / false)
# DB_SSL=false

# Optional: Trust Proxy setting when running behind reverse proxy (e.g. Nginx, Cloudflare)
# TRUST_PROXY=1
